CREATE VIEW ArticleReport AS SELECT A.ID, A.title AS TITULO, A.description AS DESCRIPCION, C.name AS CATEGORIA, L.name AS "LINEA INVESTIGACION", A.EDITORIAL, A.publication_date AS "FECHA PUBLICACION", GROUP_CONCAT(CONCAT(AU.name,' ',AU.lastname) SEPARATOR ',') as "AUTORES", A.deleted_at FROM articles A INNER JOIN categories C ON A.category_id = C.id INNER JOIN lines_investigation L ON A.line_id = L.id INNER JOIN authors AU ON A.id = AU.article_id GROUP BY A.id;